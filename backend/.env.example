RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Optional backups/context. Leave blank/off unless you intentionally wire them into a run.
COINGECKO_DEMO_API_KEY=
DEFILLAMA_ENABLED=false
DEXSCREENER_ENABLED=false

# Local/demo only. When true and RYO_MCP_KEY is empty, the backend returns
# clearly labelled simulated RYO evidence with data_mode=simulated.
APP_MOCK_RYO=false

# Durable receipts and watchlist state. Defaults to backend/data/pulse.db.
APP_DB_PATH=

APP_PORT=8788
RUST_LOG=global_token_news_pulse=info,tower_http=warn

# Optional. When true, watched tokens are checked in the background every 5+ minutes.
APP_ENABLE_WATCH_LOOP=false

# Cost and abuse controls. Values are clamped to safe ranges at startup.
APP_ANALYSIS_COOLDOWN_SECONDS=12
APP_ANALYSIS_RATE_LIMIT_PER_MINUTE=6
APP_ANALYSIS_GLOBAL_RATE_LIMIT_PER_MINUTE=40
APP_CHAT_COOLDOWN_SECONDS=2
APP_CHAT_RATE_LIMIT_PER_MINUTE=12
APP_CHAT_GLOBAL_RATE_LIMIT_PER_MINUTE=120
APP_AI_RATE_LIMIT_PER_MINUTE=30
APP_AI_MAX_CONCURRENCY=2

# Cloudflare Turnstile protects live analysis and assistant requests. Keep
# required mode off for local work unless both frontend and backend keys are set.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
APP_TURNSTILE_REQUIRED=false
